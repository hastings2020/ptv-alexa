# PTV API Credentials
# Get these from: https://www.ptv.vic.gov.au/footer/data-and-reporting/datasets/ptv-timetable-api/
PTV_DEV_ID=your_dev_id_here
PTV_API_KEY=your_api_key_here

# DynamoDB Table Name (for storing user preferences)
DYNAMODB_PERSISTENCE_TABLE_NAME=AlexaPtvSkill

# Alexa Skill ID (optional - for skill ID verification in production)
ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# AWS Region (for deployment)
AWS_REGION=ap-southeast-2
